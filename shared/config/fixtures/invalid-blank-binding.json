{
  "schema_version": 1,
  "logging": { "level": "info", "retention_days": 7 },
  "application": {
    "show_taskbar_icon": true,
    "show_status_icon": true,
    "check_for_updates_automatically": true
  },
  "appearance": { "theme": "system", "language": "en-US" },
  "overlay": {
    "visible": true,
    "click_through": false,
    "always_on_top": true,
    "scale_percent": 100,
    "opacity_percent": 100,
    "corner_radius_percent": 0,
    "hide_on_pointer_hover": false,
    "hide_on_pointer_hover_delay_seconds": 0,
    "keep_inside_screen": true
  },
  "input": {
    "gamepad_stick_dead_zone": 0.15,
    "gamepad_trigger_dead_zone": 0.0
  },
  "model": {
    "selected_model_id": null,
    "selected_model_origin": null,
    "installed_models": [],
    "preset_models": [],
    "mirror": false,
    "mirror_pointer_tracking": false,
    "play_motion_audio": true,
    "enable_behavior_shortcuts": false,
    "maximum_fps": 60,
    "ignore_pointer": false,
    "release_fallback_timeout_ms": 500
  },
  "shortcuts": {
    "commands_enabled": true,
    "commands": [{ "command": "  ", "shortcut": "Control+Alt+B" }],
    "model_behaviors": []
  }
}
