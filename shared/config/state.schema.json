{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayangweb.com/bongocat/native-state-v1.schema.json",
  "title": "BongoCat Native Application State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "settings_window"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "settings_window": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height", "maximized"],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "y": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "width": {
              "type": "integer",
              "minimum": 640,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 480,
              "maximum": 16384
            },
            "maximized": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
