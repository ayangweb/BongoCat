{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bongocat.local/schema/update-manifest-v1.json",
  "title": "BongoCat Native Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "release_version",
    "minimum_upgradable_version",
    "release_sequence",
    "published_at_unix_seconds",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "channel": { "enum": ["development", "production"] },
    "release_version": { "$ref": "#/$defs/version" },
    "minimum_upgradable_version": { "$ref": "#/$defs/version" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "published_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "release_notes_url": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/https_url" }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^/@#?\\s]+(?:[/?][^#\\s]*)?$"
    },
    "artifact_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "architecture", "url", "byte_length", "sha256"],
      "properties": {
        "target": { "type": "string" },
        "architecture": { "enum": ["aarch64", "x86_64"] },
        "url": { "$ref": "#/$defs/https_url" },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact_fields" },
        {
          "oneOf": [
            {
              "properties": {
                "target": { "const": "aarch64-apple-darwin" },
                "architecture": { "const": "aarch64" }
              }
            },
            {
              "properties": {
                "target": { "const": "x86_64-apple-darwin" },
                "architecture": { "const": "x86_64" }
              }
            },
            {
              "properties": {
                "target": { "const": "aarch64-pc-windows-msvc" },
                "architecture": { "const": "aarch64" }
              }
            },
            {
              "properties": {
                "target": { "const": "x86_64-pc-windows-msvc" },
                "architecture": { "const": "x86_64" }
              }
            }
          ]
        }
      ]
    }
  }
}
