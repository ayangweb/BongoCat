<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  macOS bundle property list overlay for the BongoCat .app.

  cargo-packager generates the bundle property list from the configuration in
  crates/bongocat-packaging/src/main.rs and then merges this file over it. Only
  keys the packager does not derive belong here, so every key keeps exactly one
  source of truth. The generated keys are:

    CFBundleIdentifier            <- the configured bundle identifier
    CFBundleShortVersionString    <- [workspace.package].version
    CFBundleVersion               <- generated build number
    CFBundleExecutable            <- the packaged binary name
    CFBundleIconFile              <- the packaged .icns
    LSMinimumSystemVersion        <- the configured minimum system version
    NSHighResolutionCapable       <- always true
-->
<dict>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!--
      The languages the bundle declares. macOS resolves a bundle's preferred localizations from
      this list intersected with the user's language preference, and a bundle nested inside the
      application follows the application's answer. The guided permission flow's Swift panel is
      such a bundle and ships the same languages, so without this list it would always fall back
      to its development region regardless of the language the product is running in (ADR-0078).
      The tags are the ones the Swift panel ships catalogues for; the product's own catalogues are
      named differently and are resolved by `bongocat-i18n` instead.
    -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>ar</string>
        <string>en</string>
        <string>pt</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
    </array>
</dict>
</plist>
