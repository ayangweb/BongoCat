#define BONGOCAT_PRODUCT_ICON 101

#if !defined(VERSION) || !defined(VERSION_MAJOR) || !defined(VERSION_MINOR) || !defined(VERSION_PATCH)
#error "VERSION, VERSION_MAJOR, VERSION_MINOR and VERSION_PATCH must be supplied by build.rs"
#endif

BONGOCAT_PRODUCT_ICON ICON "../../resources/icons/logo-windows.ico"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ayangweb\0"
            VALUE "FileDescription", "BongoCat\0"
            VALUE "FileVersion", VERSION "\0"
            VALUE "InternalName", "bongocat-app\0"
            VALUE "OriginalFilename", "bongocat-app.exe\0"
            VALUE "ProductName", "BongoCat\0"
            VALUE "ProductVersion", VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
