{
  "schema_version": 1,
  "plugins": [
    {
      "id": "pomodoro",
      "name": {
        "default": "Pomodoro",
        "by_locale": {
          "zh-CN": "番茄钟",
          "zh-TW": "番茄鐘"
        }
      },
      "version": "1.0.0",
      "author": "BongoCat",
      "description": {
        "default": "A focus timer on the model window. Start it, stop it, and let the countdown run while you work.",
        "by_locale": {
          "zh-CN": "模型窗口上的专注计时器。开始、暂停，让倒计时在你工作期间继续走。",
          "zh-TW": "模型視窗上的專注計時器。開始、暫停，讓倒數計時在你工作期間繼續走。"
        }
      },
      "icon": {
        "emoji": "🍅"
      },
      "api_version": 1,
      "downloads": {
        "macos-aarch64": {
          "path": "build/pomodoro.zip"
        },
        "macos-x86_64": {
          "path": "build/pomodoro.zip"
        },
        "windows-x86_64": {
          "path": "build/pomodoro.zip"
        }
      }
    },
    {
      "id": "keyboard-display",
      "name": {
        "default": "Key Display",
        "by_locale": {
          "zh-CN": "按键显示",
          "zh-TW": "按鍵顯示"
        }
      },
      "version": "1.0.0",
      "author": "BongoCat",
      "description": {
        "default": "Shows the keys you are holding, in the corner of the model window, so a screencast does not need a second window to prove which key you pressed.",
        "by_locale": {
          "zh-CN": "在模型窗口角落显示你正在按的键，录屏时不必再开一个窗口来证明按了哪个键。",
          "zh-TW": "在模型視窗角落顯示你正在按的鍵，錄影時不必再開一個視窗來證明按了哪個鍵。"
        }
      },
      "icon": {
        "emoji": "⌨️"
      },
      "api_version": 1,
      "downloads": {
        "macos-aarch64": {
          "path": "build/keyboard-display.zip"
        },
        "macos-x86_64": {
          "path": "build/keyboard-display.zip"
        },
        "windows-x86_64": {
          "path": "build/keyboard-display.zip"
        }
      }
    },
    {
      "id": "typing-sound",
      "name": {
        "default": "Typing Sound",
        "by_locale": {
          "zh-CN": "打字音效",
          "zh-TW": "打字音效"
        }
      },
      "version": "1.0.0",
      "author": "BongoCat",
      "description": {
        "default": "Gives the cat a voice while you type: each key plays one of the model's own motions, and the model's sound for it.",
        "by_locale": {
          "zh-CN": "打字时让猫发出声音：每按一个键就播放模型自带的一个动作，以及该动作自带的声音。",
          "zh-TW": "打字時讓貓發出聲音：每按一個鍵就播放模型自帶的一個動作，以及該動作自帶的聲音。"
        }
      },
      "icon": {
        "emoji": "🔊"
      },
      "api_version": 1,
      "downloads": {
        "macos-aarch64": {
          "path": "build/typing-sound.zip"
        },
        "macos-x86_64": {
          "path": "build/typing-sound.zip"
        },
        "windows-x86_64": {
          "path": "build/typing-sound.zip"
        }
      }
    }
  ]
}
